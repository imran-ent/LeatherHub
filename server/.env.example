NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/leather_hub

# CORS — comma-separated in prod (e.g. https://leather-hub.vercel.app,https://yourdomain.com)
CLIENT_URL=http://localhost:5173

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars

# Gmail notifications (use a Gmail App Password, not your login password) — optional
EMAIL_USER=yourname@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=yourname@gmail.com

# Admin creation (used by scripts/createAdmin.js in prod)
ADMIN_NAME=Leather-Hub Admin
ADMIN_PHONE=9876543210
# ADMIN_PASSWORD set via env only in prod — never commit

# Safety flag for seeding in prod (not recommended)
# ALLOW_SEED=1
